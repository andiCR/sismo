{
  "name": "sismo-build-trigger",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --test-scheduled",
    "logs": "wrangler tail",
    "db:init": "wrangler d1 execute sismo-push --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute sismo-push --local --file schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
